{
  "manifest_version": 2,
  "name": "tab-mcp",
  "version": "0.1.0",
  "description": "Expose the active browser tab via a local MCP server (read-only).",
  "permissions": [
    "activeTab",
    "tabs",
    "nativeMessaging",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-mcp@grasegger.dev",
      "strict_min_version": "91.0"
    }
  }
}
